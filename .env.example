# Newsren configuration. Nothing here is required for live feeds to work.
# Never prefix secrets with NEXT_PUBLIC_.

# Optional. Identifies Newsren to publishers' servers. Some sites (for example the SEC)
# ask automated clients to include contact details, e.g. "Newsren/0.1 (you@example.com)".
NEWSREN_USER_AGENT=

# Optional. "sample" serves the development fixtures with a visible notice.
# Default is live feeds; a live failure never falls back to sample content.
NEWSREN_CONTENT=

# Optional test switch: comma-separated feed ids forced to fail, e.g. "fed-press,hechinger".
NEWSREN_BLOCK_FEEDS=

# Gemini (server only; never prefix with NEXT_PUBLIC_). Put the real value in .env.local.
GEMINI_API_KEY=
# Optional. Must be a model with a free tier. Default: gemini-3.5-flash-lite
GEMINI_MODEL=
# Optional AI request limits (provider calls only; cached results are free).
NEWSREN_AI_PER_CLIENT_PER_MINUTE=
NEWSREN_AI_PER_MINUTE=
NEWSREN_AI_PER_DAY=

# Optional. Location of the SQLite article store. Default: ./.data/newsren.sqlite
# Needs a persistent, writable disk (see README "Storage and hosting").
NEWSREN_DB_PATH=

# Optional. Minimum seconds between feed refreshes. Default: 600.
NEWSREN_REFRESH_SECONDS=
